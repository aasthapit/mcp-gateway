# admin-ui image. Vite build in a UBI 9 Node.js 22 stage; the runtime is the same minimal
# image serving dist/ with server.mjs (Node built-ins only, no node_modules). Runs as UID
# 1001 / any UID in group 0 with a read-only root filesystem. Configuration is read at
# runtime from ADMIN_UI_* (served as /config.json), so one image fits every environment.
#
# Build context is the REPO ROOT: the forms read enum values from ../schemas.
#
#   podman build -t mcp-admin-ui:dev -f admin-ui/Containerfile .
#   podman run --rm -p 3000:3000 --read-only mcp-admin-ui:dev

ARG BASE=registry.access.redhat.com/ubi9/nodejs-22-minimal:latest

# ---------------------------------------------------------------------------- build
FROM ${BASE} AS build
USER 0
WORKDIR /opt/app-root/src/admin-ui
COPY admin-ui/package.json admin-ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY schemas/*.schema.json /opt/app-root/src/schemas/
COPY admin-ui/ ./
RUN npm run build

# ---------------------------------------------------------------------------- runtime
FROM ${BASE}
LABEL org.opencontainers.image.title="mcp-admin-ui" \
      org.opencontainers.image.description="Admin UI for the MCP gateway policy" \
      org.opencontainers.image.source="https://github.com/aasthapit/mcp-gateway"
USER 0
WORKDIR /opt/app-root/src/admin-ui
COPY --from=build /opt/app-root/src/admin-ui/dist ./dist
COPY admin-ui/server.mjs admin-ui/runtime-config.mjs ./
RUN printf '{"type":"module","private":true}\n' > package.json && \
    chgrp -R 0 /opt/app-root/src && chmod -R g=u,o-w /opt/app-root/src
ENV NODE_ENV=production \
    HOME=/tmp \
    ADMIN_UI_HOST=0.0.0.0 \
    ADMIN_UI_PORT=3000
USER 1001
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "server.mjs"]
