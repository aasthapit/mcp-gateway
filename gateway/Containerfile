# MCP gateway image. Red Hat UBI 9 minimal Python 3.12, deps from the uv lockfile,
# runs as the numeric non-root UID 1001 and works under OpenShift's restricted SCC
# (arbitrary UID, group 0) with readOnlyRootFilesystem (only /tmp is written).
#
#   podman build -t mcp-gateway:dev -f Containerfile .
#   podman run --rm -p 8080:8080 -p 9090:9090 --read-only --tmpfs /tmp mcp-gateway:dev

ARG BASE=registry.access.redhat.com/ubi9/python-312-minimal:latest

# ---------------------------------------------------------------------------- build
FROM ${BASE} AS build
USER 0
COPY --from=ghcr.io/astral-sh/uv:0.11.24 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/app-root/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON=/usr/bin/python3.12 \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /opt/app-root/src
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------- runtime
FROM ${BASE}
LABEL org.opencontainers.image.title="mcp-gateway" \
      org.opencontainers.image.description="Enterprise MCP gateway (FastMCP 4.1)" \
      org.opencontainers.image.source="https://github.com/aasthapit/mcp-gateway"
USER 0
COPY --from=build /opt/app-root/venv /opt/app-root/venv
# group 0 owns and may write the app dir (OpenShift runs with an arbitrary UID in GID 0);
# the gateway itself never writes there, so the root FS can be mounted read-only.
RUN chgrp -R 0 /opt/app-root/venv && chmod -R g=u /opt/app-root/venv
ENV PATH="/opt/app-root/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    TMPDIR=/tmp \
    GATEWAY_HOST=0.0.0.0 \
    GATEWAY_PORT=8080 \
    GATEWAY_METRICS_PORT=9090
WORKDIR /opt/app-root/src
USER 1001
EXPOSE 8080 9090
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2).status==200 else 1)"
ENTRYPOINT ["mcp-gateway"]
