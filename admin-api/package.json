{
  "name": "mcp-admin-api",
  "version": "0.1.0",
  "description": "Admin API for the MCP gateway policy (upstreams, toolsets, grants).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
