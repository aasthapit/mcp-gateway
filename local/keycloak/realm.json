{
  "realm": "mcp",
  "displayName": "MCP Gateway (local dev)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "mcp-developer", "description": "May use the engineering toolsets through the gateway" },
      {
        "name": "mcp-admin",
        "description": "May edit policy through the admin API/UI. Composite: carries the client role mcp-admin/policy-admin, which makes Keycloak add aud=mcp-admin (audience resolve).",
        "composite": true,
        "composites": { "client": { "mcp-admin": ["policy-admin"] } }
      }
    ],
    "client": {
      "mcp-admin": [
        {
          "name": "policy-admin",
          "description": "Holders get aud=mcp-admin in their access tokens (audience resolve). Granted only through the realm role mcp-admin, so dev1 never gets it."
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "mcp-gateway",
      "name": "MCP Gateway",
      "description": "Public client used by MCP clients (and `make token`) to obtain tokens for the gateway. Also the audience value the gateway validates.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:*", "http://127.0.0.1:*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "mcp-gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mcp-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ci-runner",
      "name": "CI runner (client credentials)",
      "description": "Confidential client for machine callers; tokens carry azp=ci-runner and aud=mcp-gateway.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ci-runner-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "protocolMappers": [
        {
          "name": "mcp-gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mcp-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "other-api",
      "name": "Other API (wrong audience)",
      "description": "Confidential client whose tokens carry aud=other-api and NOT mcp-gateway; the gateway must answer 401 (WP2 integration test). Not imported into an already-initialised Keycloak: `make clean up` re-imports the realm.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "other-api-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "protocolMappers": [
        {
          "name": "other-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "other-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mcp-admin",
      "name": "MCP admin API (resource server)",
      "description": "Audience of the admin API. No login flows: tokens issued to mcp-admin-ui (or any client) carry aud=mcp-admin only when the user has the client role mcp-admin/policy-admin (via the realm role mcp-admin).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "mcp-admin-unused-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": []
    },
    {
      "clientId": "mcp-admin-ui",
      "name": "MCP admin UI",
      "description": "Public client of the admin UI (authorization code + PKCE S256). Direct access grants are enabled for the local smoke and integration tests only (make token-admin).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "http://localhost:3000",
      "redirectUris": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "webOrigins": ["http://localhost:3000", "http://127.0.0.1:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*"
      },
      "protocolMappers": [
        {
          "name": "audience-resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev1",
      "email": "dev1@example.test",
      "firstName": "Dev",
      "lastName": "One",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "dev1", "temporary": false }],
      "realmRoles": ["mcp-developer"]
    },
    {
      "username": "admin1",
      "email": "admin1@example.test",
      "firstName": "Admin",
      "lastName": "One",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin1", "temporary": false }],
      "realmRoles": ["mcp-admin", "mcp-developer"]
    },
    {
      "username": "service-account-ci-runner",
      "enabled": true,
      "serviceAccountClientId": "ci-runner",
      "realmRoles": []
    }
  ]
}
