# Copy to local/.env (gitignored). `make up` does this for you if the file is missing.
# Everything here is DEV ONLY.

# MongoDB single-node replica set (mongo:8)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=devpass
MONGO_DB=mcp_gateway
MONGO_PORT=27017

# Keycloak (dev mode, realm `mcp` imported from local/keycloak/realm.json)
KEYCLOAK_PORT=8180
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# Issuer baked into tokens. Tokens are minted for host-side clients (make token),
# so this must be the host-visible URL. Containers reach Keycloak at http://keycloak:8080
# and must configure the JWKS URL separately from the issuer (WP2).
KC_HOSTNAME=http://localhost:8180

# Sample upstreams
SAMPLE_PUBLIC_PORT=8081
SAMPLE_PRIVATE_PORT=8082

# Gateway / admin (WP1 / WP5) – reserved
GATEWAY_PORT=8080
ADMIN_API_PORT=3001
ADMIN_UI_PORT=3000
