# Copy to local/.env (gitignored). `make up` does this for you if the file is missing.
# Everything here is DEV ONLY.

# MongoDB single-node replica set (mongo:8)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=devpass
MONGO_DB=mcp_gateway
MONGO_PORT=27017

# Keycloak (dev mode, realm `mcp` imported from local/keycloak/realm.json)
KEYCLOAK_PORT=8180
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# Issuer baked into tokens. Tokens are minted for host-side clients (make token),
# so this must be the host-visible URL. Containers reach Keycloak at http://keycloak:8080
# and must configure the JWKS URL separately from the issuer (WP2).
KC_HOSTNAME=http://localhost:8180

# Sample upstreams
SAMPLE_PUBLIC_PORT=8081
SAMPLE_PRIVATE_PORT=8082

# Gateway (host-run: `cd gateway && uv run mcp-gateway`, or `make admin-dev`)
GATEWAY_PORT=8080
# Shared secret for the gateway's /internal/* routes. The host-run gateway reads it as
# GATEWAY_INTERNAL_TOKEN, the admin-api as ADMIN_GATEWAY_INTERNAL_TOKEN (make admin-dev and
# the compose admin-api map it for you).
GATEWAY_INTERNAL_TOKEN=dev-internal-token-change-me

# Admin API + UI (WP5). Ports are fixed by Keycloak's mcp-admin-ui redirect URIs (3000).
ADMIN_API_PORT=3001
ADMIN_UI_PORT=3000
# Host-run admin-api (make admin-dev). 127.0.0.1, not localhost: the podman port forward
# is IPv4-only on macOS.
ADMIN_MONGO_URI=mongodb://root:devpass@127.0.0.1:27017/?replicaSet=rs0&directConnection=true
ADMIN_MONGO_DB=mcp_gateway
ADMIN_OIDC_ISSUER=http://localhost:8180/realms/mcp
ADMIN_JWT_AUDIENCE=mcp-admin
ADMIN_REQUIRED_ROLE=mcp-admin
ADMIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_GATEWAY_INTERNAL_URL=http://127.0.0.1:8080
# The containerised admin-api (make admin-up) reaches the host-run gateway here.
ADMIN_GATEWAY_INTERNAL_URL_CONTAINER=http://host.containers.internal:8080
ADMIN_LOG_LEVEL=info
# Admin UI runtime config (served as /config.json)
ADMIN_UI_API_BASE_URL=http://localhost:3001
ADMIN_UI_OIDC_AUTHORITY=http://localhost:8180/realms/mcp
ADMIN_UI_OIDC_CLIENT_ID=mcp-admin-ui
ADMIN_UI_GATEWAY_MCP_URL=http://localhost:8080/mcp
